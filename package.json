{
  "name": "@express-sdk/core",
  "version": "0.1.0",
  "description": "Modular Express + TypeScript SDK with batteries included",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./middlewares": {
      "import": {
        "types": "./dist/middlewares/index.d.ts",
        "default": "./dist/middlewares/index.js"
      },
      "require": {
        "types": "./dist/middlewares/index.d.cts",
        "default": "./dist/middlewares/index.cjs"
      }
    },
    "./middlewares/auth": {
      "import": {
        "types": "./dist/middlewares/auth/index.d.ts",
        "default": "./dist/middlewares/auth/index.js"
      },
      "require": {
        "types": "./dist/middlewares/auth/index.d.cts",
        "default": "./dist/middlewares/auth/index.cjs"
      }
    },
    "./middlewares/upload": {
      "import": {
        "types": "./dist/middlewares/upload/index.d.ts",
        "default": "./dist/middlewares/upload/index.js"
      },
      "require": {
        "types": "./dist/middlewares/upload/index.d.cts",
        "default": "./dist/middlewares/upload/index.cjs"
      }
    },
    "./middlewares/validate": {
      "import": {
        "types": "./dist/middlewares/validate/index.d.ts",
        "default": "./dist/middlewares/validate/index.js"
      },
      "require": {
        "types": "./dist/middlewares/validate/index.d.cts",
        "default": "./dist/middlewares/validate/index.cjs"
      }
    },
    "./middlewares/logger": {
      "import": {
        "types": "./dist/middlewares/logger/index.d.ts",
        "default": "./dist/middlewares/logger/index.js"
      },
      "require": {
        "types": "./dist/middlewares/logger/index.d.cts",
        "default": "./dist/middlewares/logger/index.cjs"
      }
    },
    "./middlewares/error": {
      "import": {
        "types": "./dist/middlewares/error/index.d.ts",
        "default": "./dist/middlewares/error/index.js"
      },
      "require": {
        "types": "./dist/middlewares/error/index.d.cts",
        "default": "./dist/middlewares/error/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      },
      "require": {
        "types": "./dist/config/index.d.cts",
        "default": "./dist/config/index.cjs"
      }
    },
    "./app": {
      "import": {
        "types": "./dist/app/index.d.ts",
        "default": "./dist/app/index.js"
      },
      "require": {
        "types": "./dist/app/index.d.cts",
        "default": "./dist/app/index.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma/index.d.ts",
        "default": "./dist/prisma/index.js"
      },
      "require": {
        "types": "./dist/prisma/index.d.cts",
        "default": "./dist/prisma/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx example/default/index.ts",
    "example:default": "tsx example/default/index.ts",
    "example:custom": "tsx example/custom/index.ts",
    "example:prisma": "tsx example/prisma/index.ts",
    "example:watch": "tsx watch example/default/index.ts",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0 || >=6.0.0 || >=7.0.0",
    "express": ">=4.18.0 || >=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": false
    }
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "express": "^5.0.1",
    "prettier": "^3.9.8",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
